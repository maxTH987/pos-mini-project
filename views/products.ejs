<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>จัดการสินค้า - POS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<%- include('navbar') %>

<% 
    let totalItems = products.length;
    let totalInventoryValue = 0;
    let outOfStockCount = 0;

    products.forEach(p => {
        totalInventoryValue += (p.cost * p.stock);
        if (p.stock === 0) {
            outOfStockCount++;
        }
    });
%>

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="saas-heading">คลังสินค้า</h2>
            <p class="saas-subheading mb-0">จัดการรายการสินค้า ราคา และสต๊อกคงเหลือ</p>
        </div>
        <div class="d-flex gap-4 text-end">
            <div>
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--saas-text-muted); font-weight: 700;">มูลค่าทุนรวม</div>
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--saas-text-main);"><%= totalInventoryValue.toLocaleString() %> ฿</div>
            </div>
            <div>
                <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--saas-danger); font-weight: 700;">สินค้าหมดสต๊อก</div>
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--saas-danger);"><%= outOfStockCount %></div>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-xl-5 col-lg-5">
            <div class="saas-surface p-4">
                <h5 class="mb-4" style="font-weight: 700; letter-spacing: -0.02em;">เพิ่มสินค้าใหม่</h5>
                <form onsubmit="addProduct(event)">
                    <div class="mb-3">
                        <label class="saas-label">รหัสบาร์โค้ด</label>
                        <input type="text" id="barcode" class="saas-input" required>
                    </div>
                    <div class="mb-3">
                        <label class="saas-label">ชื่อสินค้า</label>
                        <input type="text" id="name" class="saas-input" required>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ต้นทุน (฿)</label>
                            <input type="number" id="cost" class="saas-input" required min="0">
                        </div>
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ราคาปกติ (฿)</label>
                            <input type="number" id="price" class="saas-input" required min="0">
                        </div>
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ราคาสมาชิก (฿)</label>
                            <input type="number" id="memberPrice" class="saas-input" placeholder="ไม่มี" min="0">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="saas-label">หมวดหมู่</label>
                            <input type="text" id="category" class="saas-input" required>
                        </div>
                        <div class="col-6">
                            <label class="saas-label">สต๊อก</label>
                            <input type="number" id="stock" class="saas-input" required min="0">
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="saas-label">รูปภาพ</label>
                        <input type="url" id="imageUrl" class="saas-input" placeholder="ลิงก์ URL รูปภาพ">
                        <div class="text-center my-2" style="font-size: 0.75rem; color: var(--saas-text-muted); font-weight: 600;">หรืออัปโหลด</div>
                        <input type="file" id="imageFile" class="form-control" accept="image/*" style="border-radius: var(--radius-md); border-color: var(--border-subtle);">
                    </div>

                    <button type="submit" class="saas-btn saas-btn-primary w-100" style="padding: 1rem;">บันทึกรายการสินค้า</button>
                </form>
            </div>
        </div>

        <div class="col-xl-7 col-lg-7">
            <div class="saas-surface" style="overflow: hidden;">
                <div class="table-responsive">
                    <table class="saas-table w-100">
                        <thead>
                            <tr>
                                <th>สินค้า (<%= totalItems %>)</th>
                                <th>ราคา</th>
                                <th>สต๊อก</th>
                                <th class="text-end">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(products.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5" style="color: var(--saas-text-muted);">
                                        ยังไม่มีข้อมูลสินค้า
                                    </td>
                                </tr>
                            <% } %>
                            <% products.forEach(function(p) { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="<%= p.imageUrl || 'https://placehold.co/100x100?text=No+Image' %>" alt="<%= p.name %>" style="width: 48px; height: 48px; object-fit: contain; background-color: #fff; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); padding: 2px;">
                                            <div>
                                                <div style="font-weight: 600; color: var(--saas-text-main);"><%= p.name %></div>
                                                <div style="font-size: 0.8rem; color: var(--saas-text-muted);"><%= p.barcode || 'ไม่มีบาร์โค้ด' %> • <%= p.category || 'ทั่วไป' %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span style="font-weight: 700; color: var(--saas-text-main);"><%= p.price %> ฿</span>
                                            <% if (p.memberPrice) { %>
                                                <span style="font-size: 0.8rem; color: var(--saas-primary); font-weight: 600;">สมาชิก: <%= p.memberPrice %> ฿</span>
                                            <% } %>
                                            <span style="font-size: 0.75rem; color: var(--saas-text-muted);">ทุน: <%= p.cost %> ฿</span>
                                        </div>
                                    </td>
                                    <td>
                                        <% if(p.stock > 10) { %> 
                                            <span class="saas-badge saas-badge-success"><%= p.stock %> ชิ้น</span> 
                                        <% } else if(p.stock > 0 && p.stock <= 10) { %> 
                                            <span class="saas-badge saas-badge-warning">เหลือ <%= p.stock %></span> 
                                        <% } else { %> 
                                            <span class="saas-badge saas-badge-danger">หมดสต๊อก</span> 
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button class="saas-btn saas-btn-ghost" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"
                                                data-id="<%= p._id %>"
                                                data-name="<%= p.name %>"
                                                data-cost="<%= p.cost %>"
                                                data-price="<%= p.price %>"
                                                data-memberprice="<%= p.memberPrice || '' %>"
                                                data-stock="<%= p.stock %>"
                                                data-img="<%= p.imageUrl || '' %>"
                                                onclick="triggerEdit(this)">แก้ไข</button>
                                            <button class="saas-btn saas-btn-ghost text-danger" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;" data-id="<%= p._id %>" onclick="deleteProduct(this)">ลบ</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="editProductModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 600px;">
        <div class="modal-content saas-surface border-0 p-2">
            <div class="modal-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0" style="font-weight: 800; letter-spacing: -0.02em;">แก้ไขสินค้า</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editForm">
                    <input type="hidden" id="edit-id">
                    <div class="mb-3">
                        <label class="saas-label">ชื่อสินค้า</label>
                        <input type="text" id="edit-name" class="saas-input" required>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ต้นทุน (฿)</label>
                            <input type="number" id="edit-cost" class="saas-input" required min="0">
                        </div>
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ราคาปกติ (฿)</label>
                            <input type="number" id="edit-price" class="saas-input" required min="0">
                        </div>
                        <div class="col-4">
                            <label class="saas-label text-nowrap">ราคาสมาชิก (฿)</label>
                            <input type="number" id="edit-memberPrice" class="saas-input" placeholder="ไม่มี" min="0">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="saas-label">สต๊อก</label>
                        <input type="number" id="edit-stock" class="saas-input" required min="0">
                    </div>
                    <div class="mb-5">
                        <label class="saas-label">รูปภาพ (ลิงก์ URL)</label>
                        <input type="text" id="edit-imageUrl" class="saas-input">
                    </div>
                    <div class="d-flex gap-3 justify-content-end">
                        <button type="button" class="saas-btn saas-btn-ghost" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="button" class="saas-btn saas-btn-primary" onclick="submitEdit()">บันทึกการเปลี่ยนแปลง</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let editModalInstance;

    document.addEventListener("DOMContentLoaded", () => {
        editModalInstance = new bootstrap.Modal(document.getElementById('editProductModal'));
    });

    async function addProduct(e) {
        e.preventDefault();
        const formData = new FormData();
        formData.append('barcode', document.getElementById('barcode').value);
        formData.append('name', document.getElementById('name').value);
        formData.append('cost', document.getElementById('cost').value);
        formData.append('price', document.getElementById('price').value);
        if(document.getElementById('memberPrice').value) formData.append('memberPrice', document.getElementById('memberPrice').value);
        formData.append('stock', document.getElementById('stock').value);
        formData.append('category', document.getElementById('category').value);
        formData.append('imageUrl', document.getElementById('imageUrl').value);

        const fileInput = document.getElementById('imageFile');
        if (fileInput.files[0]) formData.append('imageFile', fileInput.files[0]);

        const res = await fetch('/api/products', { method: 'POST', body: formData });
        if(res.ok) { 
            window.location.reload(); 
        } else { 
            Swal.fire({
                icon: 'error',
                title: 'บาร์โค้ดซ้ำ',
                text: 'กรุณาตรวจสอบข้อมูลอีกครั้ง',
                confirmButtonColor: 'var(--saas-primary)'
            });
        }
    }

    function triggerEdit(btn) {
        const p = btn.dataset;
        document.getElementById('edit-id').value = p.id;
        document.getElementById('edit-name').value = p.name;
        document.getElementById('edit-cost').value = p.cost;
        document.getElementById('edit-price').value = p.price;
        document.getElementById('edit-memberPrice').value = p.memberprice || '';
        document.getElementById('edit-stock').value = p.stock;
        document.getElementById('edit-imageUrl').value = p.img;
        editModalInstance.show();
    }

    async function submitEdit() {
        const id = document.getElementById('edit-id').value;
        const formData = new FormData();
        formData.append('name', document.getElementById('edit-name').value);
        formData.append('cost', document.getElementById('edit-cost').value);
        formData.append('price', document.getElementById('edit-price').value);
        formData.append('memberPrice', document.getElementById('edit-memberPrice').value);
        formData.append('stock', document.getElementById('edit-stock').value);
        formData.append('imageUrl', document.getElementById('edit-imageUrl').value);

        const res = await fetch(`/api/products/${id}`, { method: 'PUT', body: formData });
        if(res.ok) {
            window.location.reload();
        } else {
            Swal.fire({ icon: 'error', title: 'ผิดพลาด', confirmButtonColor: 'var(--saas-primary)' });
        }
    }

    async function deleteProduct(btn) {
        const id = btn.dataset.id;
        Swal.fire({
            title: 'ลบสินค้านี้?',
            text: "ข้อมูลจะไม่สามารถกู้คืนได้",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: 'var(--saas-danger)',
            cancelButtonColor: 'var(--saas-text-muted)',
            confirmButtonText: 'ลบข้อมูล',
            cancelButtonText: 'ยกเลิก'
        }).then(async (result) => {
            if (result.isConfirmed) {
                const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
            }
        });
    }
</script>
</body>
</html>