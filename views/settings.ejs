<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - POS System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <%- include('navbar') %>

        <div class="row g-6" style="margin: 0;">
            <div class="col-12 p-0 pe-lg-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="saas-heading mb-0">ตั้งค่าระบบ (โปรโมชัน)</h2>
                </div>
                
                <div class="saas-surface p-4" style="border-radius: var(--radius-xl);">
                    <h4 class="mb-4 text-primary" style="font-weight: 700;">ตั้งค่าช่วงเวลาลดราคา</h4>
                    <form id="settings-form">
                        <div class="mb-3">
                            <label class="saas-label" for="hh-start">เวลาเริ่ม (Start Time)</label>
                            <input type="time" class="saas-input" id="hh-start" required>
                        </div>
                        <div class="mb-3">
                            <label class="saas-label" for="hh-end">เวลาสิ้นสุด (End Time)</label>
                            <input type="time" class="saas-input" id="hh-end" required>
                        </div>
                        <div class="mb-4">
                            <label class="saas-label" for="hh-discount">เปอร์เซ็นต์ส่วนลด (%)</label>
                            <input type="number" class="saas-input" id="hh-discount" min="0" max="100" required>
                        </div>

                        <button type="button" class="saas-btn saas-btn-primary w-100 py-2" onclick="saveSettings()">
                            <i class="fa-solid fa-save me-2"></i> บันทึกการตั้งค่า
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', loadSettings);

        async function loadSettings() {
            try {
                const res = await fetch('/api/settings?key=happyHour');
                const data = await res.json();
                
                if (data) {
                    document.getElementById('hh-start').value = data.start || '';
                    document.getElementById('hh-end').value = data.end || '';
                    document.getElementById('hh-discount').value = data.discountPercent || 0;
                } else {
                    document.getElementById('hh-start').value = '00:00';
                    document.getElementById('hh-end').value = '00:00';
                    document.getElementById('hh-discount').value = '0';
                }
            } catch (error) {
                console.error('Error loading settings:', error);
            }
        }

        async function saveSettings() {
            const start = document.getElementById('hh-start').value;
            const end = document.getElementById('hh-end').value;
            const discountPercent = parseFloat(document.getElementById('hh-discount').value) || 0;

            if(!start || !end) {
                return Swal.fire('ข้อมูลไม่ครบ', 'กรุณาระบุเวลาเริ่มต้นและสิ้นสุด', 'warning');
            }

            try {
                const res = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        key: 'happyHour',
                        value: { start, end, discountPercent }
                    })
                });

                if (res.ok) {
                    Swal.fire('สำเร็จ', 'บันทึกการตั้งค่าโปรโมชันเรียบร้อยแล้ว', 'success');
                } else {
                    Swal.fire('ผิดพลาด', 'ไม่สามารถบันทึกข้อมูลได้', 'error');
                }
            } catch (error) {
                Swal.fire('ผิดพลาด', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
            }
        }
    </script>
</body>
</html>
