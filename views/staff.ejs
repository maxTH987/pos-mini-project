<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>จัดการพนักงาน - POS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <%- include('navbar') %>

        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="saas-heading">จัดการพนักงาน</h2>
                <p class="saas-subheading mb-0">เพิ่ม ลบ หรือแก้ไขข้อมูลและสิทธิ์พนักงานในระบบ</p>
            </div>
            <div>
                <button class="saas-btn saas-btn-primary" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                    <i class="fa-solid fa-plus"></i> เพิ่มพนักงาน
                </button>
            </div>
        </div>

        <div class="saas-surface overflow-hidden">
            <div class="table-responsive">
                <table class="saas-table w-100 mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;"></th>
                            <th>ข้อมูลผู้ใช้</th>
                            <th>ชื่อบัญชีผู้ใช้ (Username)</th>
                            <th>สิทธิ์การใช้งาน (Role)</th>
                            <th class="text-end">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(staffList && staffList.length> 0) { %>
                            <% staffList.forEach(function(staff, index) { %>
                                <tr>
                                    <td class="text-center">
                                        <div
                                            style="width: 36px; height: 36px; border-radius: 50%; background-color: var(--saas-primary-light); color: var(--saas-primary); display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                            <%= staff.name.charAt(0).toUpperCase() %>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: var(--saas-text-main);">
                                            <%= staff.name %>
                                        </div>
                                        <div style="font-size: 0.8rem; color: var(--saas-text-muted);">ID: <%=
                                                staff._id.toString().slice(-6) %>
                                        </div>
                                    </td>
                                    <td>
                                        <span
                                            style="font-family: monospace; padding: 0.2rem 0.5rem; background-color: var(--saas-bg); border-radius: var(--radius-sm); color: var(--saas-text-muted);">
                                            <%= staff.username %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if(staff.role==='owner' ) { %>
                                            <span class="saas-badge saas-badge-primary"><i
                                                    class="fa-solid fa-crown me-1"></i> ผู้ดูแลร้าน (Owner)</span>
                                            <% } else { %>
                                                <span class="saas-badge saas-badge-neutral">พนักงานขาย (Staff)</span>
                                                <% } %>
                                    </td>
                                    <td class="text-end">
                                        <% if(staff.role !=='owner' ) { %>
                                            <button class="saas-btn saas-btn-ghost text-danger"
                                                style="padding: 0.4rem 0.8rem; font-size: 0.85rem;"
                                                data-id="<%= staff._id %>"
                                                onclick="deleteStaff(this)">ลบพนักงาน</button>
                                            <% } else { %>
                                                <span
                                                    style="font-size: 0.85rem; color: var(--saas-text-muted); font-style: italic; padding: 0.4rem 0.8rem;">ไม่สามารถลบ
                                                    Owner</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5"
                                                style="color: var(--saas-text-muted);">ไม่พบข้อมูลพนักงาน</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="addStaffModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content saas-surface border-0 p-2">
                    <div class="modal-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0" style="font-weight: 800; letter-spacing: -0.02em;">เพิ่มพนักงาน</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <form id="addStaffForm" onsubmit="addStaff(event)">
                            <div class="mb-3">
                                <label class="saas-label">ชื่อ - นามสกุลจริง</label>
                                <input type="text" id="name" class="saas-input" required>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label class="saas-label">ชื่อบัญชีผู้ใช้ (Username)</label>
                                    <input type="text" id="username" class="saas-input" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="saas-label">รหัสผ่าน (Password)</label>
                                    <input type="password" id="password" class="saas-input" required
                                        autocomplete="new-password">
                                </div>
                            </div>
                            <div class="mb-5">
                                <label class="saas-label">สิทธิ์การใช้งาน (Role)</label>
                                <select id="role" class="saas-input">
                                    <option value="staff" selected>พนักงานขาย (Staff)</option>
                                    <option value="owner">ผู้ดูแลร้าน (Owner)</option>
                                </select>
                            </div>

                            <div class="d-flex gap-3 justify-content-end">
                                <button type="button" class="saas-btn saas-btn-ghost"
                                    data-bs-dismiss="modal">ยกเลิก</button>
                                <button type="submit" class="saas-btn saas-btn-primary">เพิ่มเข้าสู่ระบบ</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        </main>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            async function addStaff(e) {
                e.preventDefault();

                const name = document.getElementById('name').value;
                const username = document.getElementById('username').value;
                const password = document.getElementById('password').value;
                const role = document.getElementById('role').value;

                if (!name || !username || !password) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'ข้อมูลไม่ครบถ้วน',
                        text: 'กรุณากรอกข้อมูลให้ครบทุกช่อง',
                        confirmButtonColor: 'var(--saas-primary)'
                    });
                    return;
                }

                try {
                    const res = await fetch('/api/staff', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, username, password, role })
                    });

                    if (res.ok) {
                        window.location.reload();
                    } else {
                        const data = await res.json();
                        Swal.fire({
                            icon: 'error',
                            title: 'บันทึกไม่สำเร็จ',
                            text: data.message || 'รหัสพนักงาน/Username อาจมีในระบบแล้ว',
                            confirmButtonColor: 'var(--saas-primary)'
                        });
                    }
                } catch (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้',
                        confirmButtonColor: 'var(--saas-primary)'
                    });
                }
            }

            function deleteStaff(btn) {
                const id = btn.dataset.id;
                Swal.fire({
                    title: 'ยืนยันการลบ',
                    text: "ข้อมูลพนักงานจะถูกลบออกจากระบบอย่างถาวร!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--saas-danger)',
                    cancelButtonColor: 'var(--saas-text-muted)',
                    confirmButtonText: 'ใช่, ฉันต้องการลบ',
                    cancelButtonText: 'ยกเลิก'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const res = await fetch(`/api/staff/${id}`, { method: 'DELETE' });
                            if (res.ok) {
                                window.location.reload();
                            } else {
                                const data = await res.json();
                                Swal.fire('ผิดพลาด!', data.message || 'ไม่สามารถลบข้อมูลได้', 'error');
                            }
                        } catch (err) {
                            Swal.fire('ผิดพลาด!', 'ติดต่อเซิร์ฟเวอร์ไม่ได้', 'error');
                        }
                    }
                });
            }
        </script>
</body>

</html>